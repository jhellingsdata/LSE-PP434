{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Linked views: hover a borough on the map or a point on the scatter, and it's highlighted in both. Both views define the same point selection (point_paintbrush) on Name. Map: map-data's Greater London boroughs, matched on the ONS code.",
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/sa/msa022_greater_london/LAD.json",
    "format": {
      "type": "topojson",
      "feature": "geog"
    }
  },
  "config": {
    "view": {
      "strokeOpacity": 0
    },
    "concat": {
      "spacing": 52
    }
  },
  "title": {
    "text": "London Borough Finances",
    "subtitleFontWeight": "normal",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "dx": 50,
    "subtitle": [
      "Left shows Assets & Borrowing; right shows 10-year population growth.",
      "Left chart excludes City of London. Grey denotes missing data.",
      ""
    ]
  },
  "transform": [
    {
      "calculate": "datum.properties.name",
      "as": "id"
    },
    {
      "calculate": "datum.id == 'Tower Hamlets' ? 1 : 0",
      "as": "missing"
    },
    {
      "lookup": "properties.id",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week09/data/council_finances_2023.csv"
        },
        "key": "ONS code",
        "fields": [
          "ONS code",
          "Assets",
          "Borrowing",
          "DebtToAssets",
          "Name",
          "PopulationChange",
          "Population",
          "YouthPopulation"
        ]
      }
    },
    {
      "calculate": "isValid(datum.Name) ? datum.Name : datum.id",
      "as": "Name"
    }
  ],
  "hconcat": [
    {
      "width": 250,
      "height": 350,
      "encoding": {
        "x": {
          "field": "Borrowing",
          "axis": {
            "titleFontWeight": "normal",
            "gridOpacity": 0.3,
            "tickOpacity": 0,
            "labelFontWeight": "lighter",
            "labelExpr": "'£'+format(datum.value/1000000, '.1f')+'B'"
          },
          "type": "quantitative"
        },
        "y": {
          "field": "Assets",
          "axis": {
            "titleFontWeight": "normal",
            "gridOpacity": 0.3,
            "tickOpacity": 0,
            "labelFontWeight": "lighter",
            "labelExpr": "'£'+format(datum.value/1000000, ',.1f')+'B'"
          },
          "scale": {
            "domain": [
              0,
              1000000
            ]
          },
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "params": [
            {
              "name": "point_paintbrush",
              "select": {
                "type": "point",
                "fields": [
                  "Name"
                ],
                "on": "pointerover"
              }
            },
            {
              "name": "grid",
              "select": "interval",
              "bind": "scales"
            }
          ],
          "encoding": {
            "color": {
              "field": "PopulationChange",
              "type": "quantitative"
            },
            "opacity": {
              "condition": {
                "param": "point_paintbrush",
                "value": 1
              },
              "value": 0.2
            }
          },
          "mark": {
            "type": "circle",
            "stroke": "rgba(0,0,0,0.8)",
            "strokeWidth": 0.5,
            "size": 50,
            "tooltip": {
              "expr": "{'Authority': datum.id, 'Debt': '£'+format(datum.Borrowing*1000, ',.4r'), 'Assets': '£'+format(datum.Assets*1000, ',.4r'), 'Ratio': format(datum.DebtToAssets, ',.3r'), 'Pop. Growth (10yr)': format(datum['PopulationChange'], '.1%')}"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "opacity": 1,
            "color": "black",
            "fontWeight": "lighter",
            "align": "left",
            "dx": 5
          },
          "transform": [
            {
              "filter": "datum.Name == point_paintbrush.Name"
            }
          ],
          "encoding": {
            "text": {
              "field": "Name"
            },
            "opacity": {
              "value": 1
            },
            "color": {
              "value": "black"
            }
          }
        }
      ],
      "transform": [
        {
          "filter": "isValid(datum.Assets) && datum.Assets > -1"
        }
      ]
    },
    {
      "height": 400,
      "width": 350,
      "layer": [
        {
          "params": [
            {
              "name": "point_paintbrush",
              "select": {
                "type": "point",
                "fields": [
                  "Name"
                ],
                "on": "pointerover"
              }
            }
          ],
          "mark": {
            "type": "geoshape",
            "tooltip": {
              "expr": "{'Authority': datum.id, 'Debt': datum.id == 'Tower Hamlets' ? 'Missing' : '£'+format(datum.Borrowing*1000, ',.4r'), 'Assets': datum.id == 'Tower Hamlets' ? 'Missing' : '£'+format(datum.Assets*1000, ',.4r'), 'Ratio': datum.id == 'Tower Hamlets' ? 'NA' : format(datum.DebtToAssets, ',.3r'), 'Pop. Growth (10yr)': format(datum['PopulationChange'], '.1%')}"
            },
            "color": "red",
            "stroke": "grey"
          },
          "encoding": {
            "strokeWidth": {
              "condition": [
                {
                  "test": "datum.Name == point_paintbrush.Name",
                  "value": 1
                }
              ],
              "value": 0
            },
            "opacity": {
              "condition": [
                {
                  "test": "datum.Name == point_paintbrush.Name | !isValid(point_paintbrush.Name)",
                  "value": 1
                }
              ],
              "value": 0.2
            },
            "color": {
              "condition": [
                {
                  "test": "datum.missing == 1",
                  "value": "lightgrey"
                }
              ],
              "field": "PopulationChange",
              "legend": {
                "titleFontWeight": "lighter",
                "orient": "none",
                "legendX": 260,
                "legendY": -5,
                "title": "Growth",
                "format": "%"
              },
              "scale": {
                "domain": [
                  -0.1,
                  0.25
                ],
                "domainMid": 0,
                "type": "linear",
                "scheme": "redyellowgreen"
              },
              "type": "quantitative"
            }
          }
        }
      ]
    }
  ]
}