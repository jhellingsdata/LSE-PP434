{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Re-indexing with a slider: pick a start year and every value is divided by that year's value (x 100). A 'window' transform with first_value finds the start year's value. The data is the ONS long-run price index, rebuilt from the annual inflation series (CDSI) and extended with CDKO, saved in the repo so the chart doesn't depend on the ONS website.",
  "config": {
    "view": {
      "stroke": "transparent"
    }
  },
  "width": 290,
  "height": 250,
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week09/data/uk_prices_long_run.csv",
    "format": {
      "parse": {
        "year": "number",
        "index": "number"
      }
    }
  },
  "title": {
    "text": "UK historical prices",
    "subtitle": [
      "Long-run retail prices index, 1800-2025. Source: ONS (series CDSI and CDKO)"
    ],
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "frame": "group",
    "offset": 8
  },
  "params": [
    {
      "name": "startYear",
      "value": 1974,
      "bind": {
        "input": "range",
        "min": 1800,
        "max": 2024,
        "step": 1,
        "name": "Index year:"
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year >= startYear"
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "index",
          "as": "index_first"
        }
      ],
      "frame": [
        null,
        null
      ],
      "sort": [
        {
          "field": "year"
        }
      ]
    },
    {
      "calculate": "datum.index / datum.index_first * 100",
      "as": "value_live"
    },
    {
      "calculate": "datetime(datum.year, 0, 1)",
      "as": "date"
    }
  ],
  "mark": {
    "type": "line",
    "color": "#179fdb"
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {
        "title": "",
        "grid": false,
        "gridOpacity": 0.6
      }
    },
    "y": {
      "field": "value_live",
      "type": "quantitative",
      "axis": {
        "title": "",
        "labelExpr": "toString(datum.value / 100) + 'x'"
      }
    }
  }
}