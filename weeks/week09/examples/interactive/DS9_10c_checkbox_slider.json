{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "The checkbox and a year slider together.",
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week09/data/us_real_gdp_per_capita.csv"
  },
  "width": 300,
  "height": 250,
  "title": {
    "text": "Real GDP Per Capita",
    "subtitle": [
      "2011 USD. Source: FRED"
    ],
    "align": "left",
    "anchor": "start",
    "fontSize": 14,
    "offset": 10,
    "subtitleFontSize": 11,
    "subtitleFontStyle": "italic"
  },
  "config": {
    "view": {
      "stroke": "transparent"
    }
  },
  "params": [
    {
      "name": "toggleZero",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Start y-axis at 0"
      }
    },
    {
      "name": "minYear",
      "value": 2000,
      "bind": {
        "input": "range",
        "min": 1948,
        "max": 2022,
        "step": 1,
        "name": "Start year:"
      }
    }
  ],
  "mark": {
    "type": "line",
    "color": "rgb(128,0,0)"
  },
  "transform": [
    {
      "calculate": "year(datum.Date)",
      "as": "foo"
    },
    {
      "filter": "year(datum.Date) >= minYear"
    }
  ],
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "axis": {
        "grid": false,
        "tickOpacity": 0,
        "labelPadding": 5
      }
    },
    "y": {
      "field": "Value",
      "type": "quantitative",
      "scale": {
        "zero": {
          "expr": "toggleZero ? true : false"
        },
        "clamp": true
      },
      "axis": {
        "title": null,
        "tickOpacity": 0,
        "grid": false,
        "format": "$,.0d"
      }
    }
  }
}