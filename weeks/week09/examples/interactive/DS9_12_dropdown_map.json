{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A dropdown map: the param picks which dish to map. The data has one row per dish, year and region, so we start with the CSV (not the map), filter to one dish and one year, then look up each region's shape (Week 7's DS7_09 pattern). The colour scale refits for each dish: compare regions, not dishes. Grey: fewer than 20 prices.",
  "title": {
    "text": {
      "expr": "'Menu prices: ' + dish + ', 2025'"
    },
    "subtitle": [
      "Median price on menus, by region. Grey: too few prices. Source: LSE Growth Lab, AutoCPI (menu photos)"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#555"
  },
  "width": 320,
  "height": 440,
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "dish",
      "value": "latte",
      "bind": {
        "input": "select",
        "options": [
          "latte",
          "flat white",
          "cappuccino",
          "croissant",
          "sausage roll",
          "fish & chips",
          "margherita",
          "cheeseburger",
          "chicken tikka masala",
          "english breakfast",
          "pad thai",
          "guinness"
        ],
        "name": "Dish "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/ITL1_UK_2021.json",
        "format": {
          "type": "topojson",
          "feature": "geog"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3e3e3",
        "stroke": "white",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week08/data/menu_iconic_by_year_region.csv",
        "format": {
          "parse": {
            "year": "number",
            "prices": "number",
            "median_price": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.item == dish && datum.year == 2025"
        },
        {
          "filter": "datum.itl1 != 'United Kingdom'"
        },
        {
          "lookup": "itl1_id",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/ITL1_UK_2021.json",
              "format": {
                "type": "topojson",
                "feature": "geog"
              }
            },
            "key": "properties.id"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "median_price",
          "type": "quantitative",
          "title": "£",
          "scale": {
            "scheme": "oranges"
          },
          "legend": {
            "format": ".2f"
          }
        },
        "tooltip": [
          {
            "field": "itl1",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "median_price",
            "type": "quantitative",
            "format": ".2f",
            "title": "Median price (£)"
          },
          {
            "field": "prices",
            "type": "quantitative",
            "format": ",",
            "title": "Prices"
          }
        ]
      }
    }
  ]
}