{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Practice 1, start: a scatter of US states. Add a hover highlight.",
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week09/data/us_states_socioeconomic.csv",
    "format": {
      "type": "csv"
    }
  },
  "title": {
    "text": "Gun deaths and income - US states",
    "subtitle": [
      "Median income (x), and firearm deaths per 100k population (y)",
      ""
    ],
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "black"
  },
  "height": 300,
  "width": 300,
  "mark": {
    "type": "circle",
    "color": "rgb(0,67,167)"
  },
  "encoding": {
    "x": {
      "field": "medIncome",
      "type": "quantitative",
      "scale": {
        "domain": [
          40000,
          80000
        ]
      },
      "title": null
    },
    "y": {
      "field": "FirearmDeaths",
      "type": "quantitative",
      "title": null
    }
  }
}