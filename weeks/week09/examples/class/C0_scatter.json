{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Start: a scatter of 141 countries, coloured by continent. A tooltip, but no other interactivity. Every step below adds a selection: (1) a select param, (2) a condition that uses it, (3) a trigger.",
  "title": {
    "text": "Richer countries live longer",
    "subtitle": [
      "GDP per person and life expectancy, by country",
      "Source: World Bank, UN"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#555"
  },
  "width": 480,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week09/data/gdp_life_expectancy.csv",
    "format": {
      "parse": {
        "GDP per capita (PPP)": "number",
        "Life Expectancy": "number"
      }
    }
  },
  "mark": {
    "type": "circle",
    "size": 80
  },
  "encoding": {
    "x": {
      "field": "GDP per capita (PPP)",
      "type": "quantitative",
      "title": "GDP per person (PPP $, log scale)",
      "scale": {
        "type": "log",
        "domain": [
          1000,
          140000
        ]
      },
      "axis": {
        "values": [
          1000,
          2000,
          5000,
          10000,
          20000,
          50000,
          100000
        ],
        "format": "$,"
      }
    },
    "y": {
      "field": "Life Expectancy",
      "type": "quantitative",
      "title": "Life expectancy (years)",
      "scale": {
        "domain": [
          50,
          87
        ]
      }
    },
    "color": {
      "field": "Continent",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Africa",
          "America",
          "Asia",
          "Europe",
          "Oceania"
        ],
        "scheme": "tableau10"
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "Country",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "Continent",
        "type": "nominal",
        "title": "Continent"
      },
      {
        "field": "GDP per capita (PPP)",
        "type": "quantitative",
        "format": "$,.0f",
        "title": "GDP per person"
      },
      {
        "field": "Life Expectancy",
        "type": "quantitative",
        "format": ".1f",
        "title": "Life expectancy"
      }
    ]
  }
}