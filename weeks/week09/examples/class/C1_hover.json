{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "1. Hover: a 'point' selection. 'on': 'pointerover' selects the point under the pointer, 'clear': 'pointerout' lets go when you move away. The opacity condition uses it: 1 when selected, 0.15 otherwise. Until you hover, nothing is selected, and an empty selection counts as everything ('empty': true is the default), so all points start at full strength.",
  "title": {
    "text": "Richer countries live longer",
    "subtitle": [
      "Hover over a country",
      "Source: World Bank, UN"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#555"
  },
  "width": 480,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week09/data/gdp_life_expectancy.csv",
    "format": {
      "parse": {
        "GDP per capita (PPP)": "number",
        "Life Expectancy": "number"
      }
    }
  },
  "mark": {
    "type": "circle",
    "size": 80
  },
  "encoding": {
    "x": {
      "field": "GDP per capita (PPP)",
      "type": "quantitative",
      "title": "GDP per person (PPP $, log scale)",
      "scale": {
        "type": "log",
        "domain": [
          1000,
          140000
        ]
      },
      "axis": {
        "values": [
          1000,
          2000,
          5000,
          10000,
          20000,
          50000,
          100000
        ],
        "format": "$,"
      }
    },
    "y": {
      "field": "Life Expectancy",
      "type": "quantitative",
      "title": "Life expectancy (years)",
      "scale": {
        "domain": [
          50,
          87
        ]
      }
    },
    "color": {
      "field": "Continent",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Africa",
          "America",
          "Asia",
          "Europe",
          "Oceania"
        ],
        "scheme": "tableau10"
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "Country",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "Continent",
        "type": "nominal",
        "title": "Continent"
      },
      {
        "field": "GDP per capita (PPP)",
        "type": "quantitative",
        "format": "$,.0f",
        "title": "GDP per person"
      },
      {
        "field": "Life Expectancy",
        "type": "quantitative",
        "format": ".1f",
        "title": "Life expectancy"
      }
    ],
    "opacity": {
      "condition": {
        "param": "pick",
        "value": 1
      },
      "value": 0.15
    }
  },
  "params": [
    {
      "name": "pick",
      "select": {
        "type": "point",
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ]
}