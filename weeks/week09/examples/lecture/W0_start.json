{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Start: one dish, hard-coded in the filter ('latte'). Every widget below replaces a hard-coded value like this with a param.",
  "width": 500,
  "height": 280,
  "title": {
    "text": "The price of a latte",
    "subtitle": [
      "Median price on UK menus. Source: LSE Growth Lab, AutoCPI (menu photos)"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#555"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week08/data/menu_percentiles_by_year.csv",
    "format": {
      "parse": {
        "year": "number",
        "p10": "number",
        "p25": "number",
        "median": "number",
        "p75": "number",
        "p90": "number",
        "prices": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.item == 'latte'"
    },
    {
      "calculate": "datetime(datum.year, 0, 1)",
      "as": "date"
    }
  ],
  "mark": {
    "type": "line",
    "color": "#8c5a2b",
    "point": {
      "color": "#8c5a2b"
    }
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%Y",
        "tickCount": "year"
      }
    },
    "y": {
      "field": "median",
      "type": "quantitative",
      "title": "£",
      "scale": {
        "zero": false
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "median",
        "type": "quantitative",
        "format": ".2f",
        "title": "Median (£)"
      }
    ]
  }
}