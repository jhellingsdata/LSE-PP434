{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Step 3: a layer. An area from the 10th to the 90th percentile (y and y2) sits under the median line, so the chart shows the spread, not just the middle.",
  "width": 500,
  "height": 280,
  "title": {
    "text": {
      "expr": "'The price of a ' + dish"
    },
    "subtitle": [
      "Median price, and the middle 80% of prices (10th to 90th percentile). Source: LSE Growth Lab, AutoCPI (menu photos)"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#555"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week08/data/menu_percentiles_by_year.csv",
    "format": {
      "parse": {
        "year": "number",
        "p10": "number",
        "median": "number",
        "p90": "number",
        "prices": "number"
      }
    }
  },
  "params": [
    {
      "name": "dish",
      "value": "latte",
      "bind": {
        "input": "select",
        "options": [
          "latte",
          "flat white",
          "cappuccino",
          "croissant",
          "sausage roll",
          "fish & chips",
          "margherita",
          "cheeseburger",
          "chicken tikka masala",
          "english breakfast",
          "pad thai",
          "guinness"
        ],
        "name": "Dish "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.item == dish"
    },
    {
      "calculate": "datetime(datum.year, 0, 1)",
      "as": "date"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%Y"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#ecdfd0"
      },
      "encoding": {
        "y": {
          "field": "p10",
          "type": "quantitative",
          "title": "£"
        },
        "y2": {
          "field": "p90"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#8c5a2b",
        "point": {
          "color": "#8c5a2b"
        }
      },
      "encoding": {
        "y": {
          "field": "median",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "p10",
            "type": "quantitative",
            "format": ".2f",
            "title": "10th percentile (£)"
          },
          {
            "field": "median",
            "type": "quantitative",
            "format": ".2f",
            "title": "Median (£)"
          },
          {
            "field": "p90",
            "type": "quantitative",
            "format": ".2f",
            "title": "90th percentile (£)"
          },
          {
            "field": "prices",
            "type": "quantitative",
            "format": ",",
            "title": "Prices"
          }
        ]
      }
    }
  ]
}