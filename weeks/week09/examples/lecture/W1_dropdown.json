{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "1. Dropdown: a param bound to a 'select' input. Recipe: (1) give the hard-coded value a name, a param with a value; (2) use the param where the value was: datum.item == dish; (3) add 'bind' to get a widget. Don't call the param 'item': Vega reserves it.",
  "width": 500,
  "height": 280,
  "title": {
    "text": {
      "expr": "'The price of a ' + dish"
    },
    "subtitle": [
      "Median price on UK menus. Pick a dish. Source: LSE Growth Lab, AutoCPI (menu photos)"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#555"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week08/data/menu_percentiles_by_year.csv",
    "format": {
      "parse": {
        "year": "number",
        "p10": "number",
        "p25": "number",
        "median": "number",
        "p75": "number",
        "p90": "number",
        "prices": "number"
      }
    }
  },
  "params": [
    {
      "name": "dish",
      "value": "latte",
      "bind": {
        "input": "select",
        "options": [
          "latte",
          "flat white",
          "cappuccino",
          "croissant",
          "sausage roll",
          "fish & chips",
          "margherita",
          "cheeseburger",
          "chicken tikka masala",
          "english breakfast",
          "pad thai",
          "guinness"
        ],
        "name": "Dish "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.item == dish"
    },
    {
      "calculate": "datetime(datum.year, 0, 1)",
      "as": "date"
    }
  ],
  "mark": {
    "type": "line",
    "color": "#8c5a2b",
    "point": {
      "color": "#8c5a2b"
    }
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%Y",
        "tickCount": "year"
      }
    },
    "y": {
      "field": "median",
      "type": "quantitative",
      "title": "£",
      "scale": {
        "zero": false
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "median",
        "type": "quantitative",
        "format": ".2f",
        "title": "Median (£)"
      }
    ]
  }
}