{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "One dataset, four colour scales. Continuous: London's very high value stretches the scale, so everywhere else looks the same. Quantile: each colour has the same number of areas, showing the ranking. Threshold: you choose the breaks (here round numbers). Diverging: colours run either way from a middle value, here England's GVA per head (£38,095, see data/msa/README.md): above or below average. West of England has no figure: it is grey from a base layer, and toNumber() turns its empty cell into a missing number. Values copied by a lookup stay as text, so an empty cell ('') would otherwise count as a value and be coloured.",
  "columns": 2,
  "concat": [
    {
      "title": {
        "text": "Continuous",
        "anchor": "start",
        "subtitle": "London stretches the scale",
        "subtitleColor": "grey",
        "subtitleFontSize": 11
      },
      "width": 230,
      "height": 270,
      "projection": {
        "type": "mercator"
      },
      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/LAD_ENG_2026_05.json",
            "format": {
              "type": "topojson",
              "feature": "geog"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#f2f2f2",
            "stroke": "white",
            "strokeWidth": 0.2
          }
        },
        {
          "data": {
            "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/SA_ENG_2026_07.json",
            "format": {
              "type": "topojson",
              "feature": "geog"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#cccccc",
            "stroke": "white",
            "strokeWidth": 0.6
