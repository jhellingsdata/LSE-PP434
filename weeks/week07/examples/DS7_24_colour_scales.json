            "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/SA_ENG_2026_07.json",
            "format": {
              "type": "topojson",
              "feature": "geog"
            }
          },
          "transform": [
            {
              "lookup": "properties.id",
              "from": {
                "data": {
                  "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week07/data/msa/msa_latest.csv"
                },
                "key": "geo_id",
                "fields": [
                  "gva_per_head"
                ]
              }
            },
            {
              "calculate": "toNumber(datum.gva_per_head)",
              "as": "gva_per_head"
            },
            {
              "filter": "isValid(datum.gva_per_head)"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "white",
            "strokeWidth": 0.6
          },
          "encoding": {
            "color": {
              "field": "gva_per_head",
              "type": "quantitative",
              "title": "£",
              "legend": {
                "format": ",.0f"
              },
              "scale": {
                "scheme": "blues"
              }
            },
            "tooltip": [
              {
                "field": "properties.name",
                "title": "Strategic authority"
              },
              {
                "field": "gva_per_head",
                "type": "quantitative",
                "format": ",.0f",
                "title": "GVA per head (£)"
              }
            ]
          }
        }
      ]
