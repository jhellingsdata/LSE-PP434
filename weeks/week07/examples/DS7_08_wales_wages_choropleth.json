{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A choropleth. Start with the map, then 'lookup' each area's id (properties.id) in the CSV (column geo_id) and copy across its value. The CSV has ONE row per area. Two layers: underneath, every council in grey, with a tooltip that says 'No data'; on top, the councils coloured by their value. Vega-Lite leaves out shapes with a missing value, so where there's no data the grey layer shows through (the base-layer idea from the lecture). Another way, in one layer: \"invalid\": \"show\" in the mark plus a grey colour condition (see DS7_17).",
  "title": {
    "text": "Wages in Wales, 2024",
    "anchor": "start",
    "subtitle": "Annual wages (£). Grey: no data. Source: ONS",
    "subtitleColor": "grey",
    "subtitleFontSize": 11
  },
  "width": 320,
  "height": 380,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/LAD_WLS_2026_05.json",
        "format": {
          "type": "topojson",
          "feature": "geog"
        }
      },
      "transform": [
        {
          "calculate": "'No data'",
          "as": "no_data"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e3e3e3",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Local authority"
          },
          {
            "field": "no_data",
            "title": "Wages (£)"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/LAD_WLS_2026_05.json",
        "format": {
          "type": "topojson",
          "feature": "geog"
        }
      },
      "transform": [
        {
          "lookup": "properties.id",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week07/data/wales_wages_2024.csv"
            },
            "key": "geo_id",
            "fields": [
              "value"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "£ a year",
          "scale": {
            "scheme": "blues"
          },
          "legend": {
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Local authority"
          },
          {
            "field": "value",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Wages (£)"
          }
        ]
      }
    }
  ]
}
