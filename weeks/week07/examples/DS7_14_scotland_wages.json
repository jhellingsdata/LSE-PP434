{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Scotland, using the 'many years' pattern from DS7_09: start with the CSV, filter to a year, look up the shapes.",
  "title": {
    "text": "Wages in Scotland, 2024",
    "anchor": "start",
    "subtitle": "Annual wages (£). Source: ONS",
    "subtitleColor": "grey",
    "subtitleFontSize": 11
  },
  "width": 320,
  "height": 420,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/LAD_SCT_2026_05.json",
        "format": {
          "type": "topojson",
          "feature": "geog"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3e3e3",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week07/data/wages_LAD_SCT.csv"
      },
      "transform": [
        {
          "filter": "datum.date == 2024"
        },
        {
          "lookup": "geo_id",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/LAD_SCT_2026_05.json",
              "format": {
                "type": "topojson",
                "feature": "geog"
              }
            },
            "key": "properties.id"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "£ a year",
          "scale": {
            "scheme": "purples"
          },
          "legend": {
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "geo.properties.name",
            "title": "Council"
          },
          {
            "field": "value",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Wages (£)"
          }
        ]
      }
    }
  ]
}
