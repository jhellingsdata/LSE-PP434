{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "The same lookup, with much smaller areas: Wales's 408 MSOAs (Middle layer Super Output Areas, about 7,000 people each).",
  "title": {
    "text": "Wales: population density",
    "anchor": "start",
    "subtitle": "People per km², by MSOA, 2021 Census",
    "subtitleColor": "grey",
    "subtitleFontSize": 11
  },
  "width": 320,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/MSOA_WLS_2021.json",
    "format": {
      "type": "topojson",
      "feature": "geog"
    }
  },
  "transform": [
    {
      "lookup": "properties.id",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week07/data/wales_pop_density_msoa.csv"
        },
        "key": "geo_id",
        "fields": [
          "value"
        ]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.2
  },
  "encoding": {
    "color": {
      "field": "value",
      "type": "quantitative",
      "title": "People per km²",
      "scale": {
        "type": "log",
        "scheme": "oranges"
      },
      "legend": {
        "format": ",.0f"
      }
    },
    "tooltip": [
      {
        "field": "properties.name",
        "title": "Area"
      },
      {
        "field": "value",
        "type": "quantitative",
        "format": ",.0f",
        "title": "People per km²"
      }
    ]
  }
}
