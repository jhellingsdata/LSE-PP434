{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Step 5. Now it's a chart like any other: encode passengers as size, and add a tooltip.",
  "title": {
    "text": "Step 5: size and tooltip",
    "anchor": "start"
  },
  "width": 300,
  "height": 400,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/CTRY_UK.json",
        "format": {
          "type": "topojson",
          "feature": "geog"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3e3e3",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week07/data/uk_airports.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#d35400",
        "opacity": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "passengers",
          "type": "quantitative",
          "title": "Passengers",
          "scale": {
            "range": [
              10,
              600
            ]
          }
        },
        "tooltip": [
          {
            "field": "airport",
            "title": "Airport"
          },
          {
            "field": "passengers",
            "type": "quantitative",
            "format": ",",
            "title": "Passengers"
          }
        ]
      }
    }
  ]
}
