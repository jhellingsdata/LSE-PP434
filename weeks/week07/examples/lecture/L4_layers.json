{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Step 4. Put them together with a layer: the map first (underneath), then the points (on top). The projection moves to the top, so both layers use the same one and line up.",
  "title": {
    "text": "Step 4: map + points = a layer",
    "anchor": "start"
  },
  "width": 300,
  "height": 400,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/CTRY_UK.json",
        "format": {
          "type": "topojson",
          "feature": "geog"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3e3e3",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/LSE-PP434/main/weeks/week07/data/uk_airports.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#d35400"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      }
    }
  ]
}
